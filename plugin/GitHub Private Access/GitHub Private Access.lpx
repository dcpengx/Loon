#!name = GitHub Private Access
#!desc = 访问私有仓库链接，可用于从私库下载资源
#!author = dcpengx[https://github.com/dcpengx/Loon/tree/main]
#!homePage = https://github.com/dcpengx/Loon/tree/main/plugin/GitHub%20Private%20Access
#!data = 2026-09-12
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/GitHub.png
#!system = ios,tvos,macos
#!system_version = 15.0
#!loon_version = 3.5.1(980)
#!tag =功能增强

[Argument]
username = input,"https:\/\/(?:raw|gist)\.githubusercontent\.com\/username\/",tag=用户名,desc=将正则中的`username`改成你的GitHub用户名
token = input,"",tag=token,desc=填写你申请的token

[rewrite]
request if ${url} ~= ${username} && ${request.header['user-agent']} ~= /^Loon/ then request.header.set("Authorization", "token ${token}")

[MITM]
hostname = raw.githubusercontent.com, gist.githubusercontent.com
