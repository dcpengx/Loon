#!name=telegram外链跳转可选版
#!desc= telegram外链直接跳转第三方客户端打开\nsg：swiftgram \nturrit:turrit \nime:ime \nnagram直接用tg
#!author= 秦城二院彭医生[https://github.com/dcpengx/Loon/]
#!icon= https://raw.githubusercontent.com/Orz-3/mini/master/Color/Telegram.png
#!system = ios,ipados
#!data=2026-8-3
#!system_version = 15
#!loon_version = 3.5.1978)
#!tag = 功能增强

[argument]
jump = select,"tg","sg","turrit","ime",tag=指定跳转客户端,desc=选择跳转到哪个第三方tg
[Rewrite]
request if ${url} ~= /^(https)?:\/\/t\.me\/(.+)/ as item then redirect(302, "${jump}://resolve?domain=${item.2}")

[MITM]
hostname = t.me
